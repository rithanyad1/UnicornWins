APP_ENV=development
HOST=0.0.0.0
PORT=8000

# SpacetimeDB (optional). URI is maincloud by default; use http://127.0.0.1:3000 for `spacetime start`.
SPACETIMEDB_URI=https://maincloud.spacetimedb.com
SPACETIMEDB_DATABASE=unicornwins-5gkbd
SPACETIMEDB_TOKEN=

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ACTIONS_ENABLED=false
# Background incident analysis; tool calls on Gemini can exceed 20 s under load.
GEMINI_TIMEOUT_SECONDS=60

ESP32_DEVICE_TOKEN=
PICO_DEVICE_TOKEN=
OPERATOR_API_KEY=

SIMULATION_ENABLED=true

HIGH_TEMP_THRESHOLD=35
CRITICAL_TEMP_THRESHOLD=40
RECOVERY_TEMP_THRESHOLD=32
HIGH_HUMIDITY_THRESHOLD=70
VIBRATION_THRESHOLD=0.7
DEVICE_TIMEOUT_SECONDS=15
TELEMETRY_PERSIST_INTERVAL_SECONDS=5
RECOVERY_STABILITY_SECONDS=10
ANOMALY_MODEL_PATH=data/models/isolation_forest.joblib
ANOMALY_BASELINE_PATH=data/baseline/baseline.csv