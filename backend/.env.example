APP_ENV=development
HOST=0.0.0.0
PORT=8000

# SpacetimeDB (optional). URI is maincloud by default; use http://127.0.0.1:3000 for `spacetime start`.
SPACETIMEDB_URI=https://maincloud.spacetimedb.com
SPACETIMEDB_DATABASE=unicornwins-5gkbd
SPACETIMEDB_TOKEN=

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ACTIONS_ENABLED=false
# Background incident analysis; tool calls on Gemini can exceed 20 s under load.
GEMINI_TIMEOUT_SECONDS=60

ESP32_DEVICE_TOKEN=
PICO_DEVICE_TOKEN=
# The SENTINEL Pico 2 W node, forwarded by scripts/serial_bridge.py. Blank uses dev-sentinel-token in development.
SENTINEL_DEVICE_ID=SENTINEL-01
SENTINEL_DEVICE_TOKEN=
OPERATOR_API_KEY=

# Off so the dashboard shows only the real node. The simulator's normal readings (~25 C)
# assume the original 35/40 C thresholds; restore those if you turn it back on.
SIMULATION_ENABLED=false

# These match the SENTINEL node firmware's demo thresholds: warning 74 F, critical 76 F,
# humidity warning above 60 %, vibration warning 0.20 g. The node acts on its own copy;
# the backend uses these to open and verify incidents.
HIGH_TEMP_THRESHOLD=23.3
CRITICAL_TEMP_THRESHOLD=24.4
RECOVERY_TEMP_THRESHOLD=22.8
HIGH_HUMIDITY_THRESHOLD=60
VIBRATION_THRESHOLD=0.2
DEVICE_TIMEOUT_SECONDS=15
TELEMETRY_PERSIST_INTERVAL_SECONDS=5
RECOVERY_STABILITY_SECONDS=10
ANOMALY_MODEL_PATH=data/models/isolation_forest.joblib
ANOMALY_BASELINE_PATH=data/baseline/baseline.csv